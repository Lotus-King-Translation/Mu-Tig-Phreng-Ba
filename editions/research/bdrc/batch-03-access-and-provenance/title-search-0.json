","value":"rediscovered teachings"}]},"main":{"http://purl.bdrc.io/resource/MW3CN7084":[{"type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#type","value":"http://purl.bdrc.io/ontology/core/Instance"},{"type":"http://purl.bdrc.io/ontology/core/script","value":"http://purl.bdrc.io/resource/ScriptDbuCan"},{"type":"http://purl.bdrc.io/ontology/tmp/provider","value":"http://purl.bdrc.io/admindata/CP021"},{"xml:lang":"","type":"http://purl.bdrc.io/ontology/tmp/yearStart","value":"2016"},{"type":"http://purl.bdrc.io/ontology/core/copyrightStatus","value":"http://purl.bdrc.io/resource/CopyrightClaimed"},{"type":"http://purl.bdrc.io/ontology/core/workIsAbout","value":"http://purl.bdrc.io/resource/T1388"},{"xml:lang":"en","type":"http://purl.bdrc.io/ontology/core/catalogInfo","value":"Collected seventeen Nyingmapa Tantras of the Man-ngag-sde-yang-gsang-bla-med, class of the Atiyoga (rDzogs-chen)."},{"type":"http://purl.bdrc.io/ontology/core/material","value":"http://purl.bdrc.io/resource/MaterialPaper"},{"xml:lang":"","type":"http://purl.bdrc.io/ontology/tmp/possibleAccess","value":"true"},{"type":"http://purl.bdrc.io/ontology/core/associatedTradition","value":"http://purl.bdrc.io/resource/TraditionNyingma"},{"xml:lang":"","type":"http://purl.bdrc.io/ontology/core/extentStatement","value":"2 v."},{"xml:lang":"","type":"http://purl.bdrc.io/ontology/tmp/hasEtext","value":"false"},{"type":"http://purl.bdrc.io/ontology/tmp/thumbnailIIIFService","value":"https://iiif.bdrc.io/bdr:I3CN8461::I3CN84610003.tif"},{"type":"http://purl.bdrc.io/ontology/core/language","value":"http://purl.bdrc.io/resource/LangBo"},{"type":"http://purl.bdrc.io/ontology/core/workIsAbout","value":"http://purl.bdrc.io/resource/T1389"},{"xml:lang":"","type":"http://purl.bdrc.io/ontology/tmp/catalogOnly","value":"false"},{"type":"http://purl.bdrc.io/ontology/tmp/status","value":"http://purl.bdrc.io/admindata/StatusReleased"},{"type":"http://purl.bdrc.io/ontology/tmp/hasReproAccess","value":"http://purl.bdrc.io/admindata/AccessFairUse"},{"type":"http://purl.bdrc.io/ontology/core/instanceHasReproduction","value":"http://purl.bdrc.io/resource/W3CN7084"},{"xml:lang":"bo-x-ewts","type":"http://purl.bdrc.io/ontology/core/publisherLocation","value":"khren tu'u/"},{"xml:lang":"","type":"http://purl.bdrc.io/ontology/tmp/hasOpen","value":"false"},{"type":"http://purl.bdrc.io/ontology/core/binding","value":"http://purl.bdrc.io/resource/Binding_Codex_Perfect"},{"xml:lang":"bo","type":"http://www.w3.org/2004/02/skos/core#altLabel","value":"རྒྱུད་བཅུ་བདུན། བཅུ་བདུན་རྒྱུད། གསང་ཆེན་ངེས་པའི་རྒྱུད་བཅུ་བདུན། ཡང་གསང་སྙིང་ཐིག་གི་རྒྱུད་བཅུ་བདུན། མངོན་སུམ་སྙིང་ཐིག་གི་རྒྱུད་བཅུ་བདུན། མན་ངག་ཡང་གསང་བླ་མེད་ཀྱི་རྫོགས་ཆེན་རྒྱུད་བཅུ་བདུན།"},{"xml:lang":"bo","type":"http://purl.bdrc.io/ontology/core/biblioNote","value":"་ལྟ་བུ་ངོ་སྤྲོད་རིན་པོ་ཆེ་སྤྲས་པའི་ཞིང་ཁམས་བསྟན་པའི་རྒྱུད་»དང་། ༼༡༢༽«མུ་ཏིག་བསྟར་ལ་བརྒྱུས་པ་ལྟ་བུ་↦མུ་ཏིག་རིན་པོ་ཆེ↤་ཕྲེང་བའི"},{"type":"http://purl.bdrc.io/ontology/core/workGenre","value":"http://purl.bdrc.io/resource/T00AG01243"},{"type":"http://purl.bdrc.io/ontology/tmp/author","value":"http://purl.bdrc.io/resource/P0RK1221"},{"xml:lang":"","type":"http://purl.bdrc.io/ontology/tmp/hasImage","value":"true"},{"type":"http://purl.bdrc.io/ontology/core/contentMethod","value":"http://purl.bdrc.io/resource/ContentMethod_ComputerInput"},{"xml:lang":"bo","type":"http://www.w3.org/2004/02/skos/core#prefLabel","value":"རྫོགས་ཆེན་རྒྱུད་བཅུ་བདུན། (སི་ཁྲོན་དེང་རབས་འཕྲུལ་པར།)"},{"xml:lang":"","type":"http://purl.bdrc.io/ontology/tmp/associatedCentury","value":"10"},{"type":"http://purl.bdrc.io/ontology/core/instanceOf","value":"http://purl.bdrc.io/resource/WA1KG892"},{"xml:lang":"","type":"http://purl.bdrc.io/ontology/tmp/matchScore","value":"2.6098928"},{"xml:lang":"","type":"http://purl.bdrc.io/ontology/core/numberOfVolumes","value":"2"},{"xml:lang":"bo-x-ewts","type":"http://purl.bdrc.io/ontology/core/publisherName","value":"si khron mi rigs dpe skrun khang /"},{"type":"http://purl.bdrc.io/ontology/core/workIsAbout","value":"http://purl.bdrc.io/resource/T354"},{"xml:lang":"bo","type":"http://purl.bdrc.io/ontology/core/catalogInfo","value":"༈ དེ་ལ་འདིར་«རྫོགས་ཆེན་རྒྱུད་བཅུ་བདུན་»ཞེས་པ་ནི། སྤྱིར་གསང་སྔགས་སྔ་འགྱུར་རྙིང་མ་ལ་ཕྱི་རྒྱུད་སྡེ་གསུམ་དང་ནང་རྒྱུད་སྡེ་གསུམ་བཅས་རྒྱུད་སྡེ་ཆེན་མོ་དྲུག་གི་རྣམ་གཞག་མཛད་པ་ལས། འདི་ནི་ནང་རྒྱུད་རྣལ་འབྱོར་བླ་མེད་ཀྱི་རྒྱུད་ཀྱི་ཁོངས་གཏོགས་དང་། དེ་ལའང་མ་ཧཱ་ཨ་ནུ་ཨ་ཏི་བཅས་གསུམ་ལས་ཨ་ཏི་ཡོ་གའི་རྒྱུད། དེ་ལའང་ནང་གསེས་སེམས་ཀློང་མན་ངག་གི་སྡེ་གསུམ་ལས་མན་ངག་གི་རྒྱུད། ཡང་དེ་ལའང་ཕྱི་སྐོར་ནང་སྐོར་གསང་སྐོར་ཡང་གསང་བླ་མེད་ཀྱི་སྐོར་བཅས་སྐོར་ཚོ་ཆེན་མོ་བཞི་ལས། འདི་ནི་ཐེག་དགུའི་རྩེ་མོ་འོད་གསལ་རྡོ་རྗེ་སྙིང་པོའི་གྲུབ་མཐའ་རྩལ་འདོན་མཛད་པ་མན་ངག་ཡང་གསང་བླ་མེད་ཀྱི་རྒྱུད་དམ་མངོན་སུམ་སྙིང་ཐིག་གི་རྒྱུད་དུ་གྲགས།\n\nདེ་ལའང་པཎྜི་ཏ་ཆེན་པོ་བི་མ་ལ་མི་ཏྲ་ (fl. mid. 8ᵗʰ cent.; BDRC: P5011) ནས་བརྒྱུད་པའི་བི་མའི་བཀའ་སྲོལ་«གསང་བ་སྙིང་ཐིག་»དང་། ཨོ་རྒྱན་གྱི་སློབ་དཔོན་ཆེན་པོ་པདྨ་འབྱུང་གནས་ (fl. mid. 8ᵗʰ cent.; BDRC: P4956) ནས་བརྒྱུད་པའི་པདྨའི་བཀའ་སྲོལ་«མཁའ་འགྲོ་སྙིང་ཐིག་»དེ་བཞིན་ལོ་ཆེན་བཻ་རོ་ཙ་ན་ (fl. late 8ᵗʰ cent.; BDRC: P5013) ནས་བརྒྱུད་པའི་བཻ་རོའི་བཀའ་སྲོལ་«བཻ་རོ་སྙིང་ཐིག་»བཅས་གསུམ་དུ་གྲགས་པ་ལས་འདི་ནི་དང་པོའི་ཁོངས་གཏོགས་ཡིན། བཀའ་སྲོལ་མཐའ་མ་ལ་རྒྱུད་ལོགས་སུ་མེད་ཀྱང་དང་པོ་གཉིས་ལ་«ཟབ་པ་ཀུ་ས་ལིའི་སྐོར་»དང་«རྒྱ་ཆེ་བ་པཎྜི་ཏའི་སྐོར་»བཅས་གཉིས་རེ་བཞུགས་པ་ལས་འདི་ནི་ཕྱི་མ་པཎྜི་ཏའི་སྐོར་ཡིན། བཀའ་སྲོལ་དང་པོའི་རྒྱ་ཆེ་བའི་སྐོར་དེ་གནས་བརྟན་ཆེན་པོ་ལྡང་མ་ལྷུན་རྒྱལ་ (fl. late 10ᵗʰ cent.; BDRC: P0RK1221) གྱིས་སྔོན་མཁན་སློབ་ཆོས་གསུམ་སྐབས་ཀྱི་ཡིག་རྙིང་དེང་སང་ཏུན་ཧོང་བྲག་ཕུག་ནས་བླངས་པ་ལྟར་གཏེར་ནས་བཞེས་ཡོད་པར་གྲགས།\n\nདེ་ལའང་«གསང་ཆེན་ངེས་པའི་རྒྱུད་བཅུ་བདུན་»དང་མཐར་«སྔགས་སྲུང་ཁྲོས་མ་ནག་མོའི་རྒྱུད་»བཅས་བཅོ་བརྒྱད་བཞུགས་པའི་ནང་གསེས་«སྒྲ་ཐལ་འགྱུར་ཆེན་པོ་རྩ་བའི་རྒྱུད་»ལས། “ཡང་དག་ཆོས་ཉིད་སྒྲ་ལས་ཐལ༔ རང་གི་ངོ་བོ་ཡི་གེ་མེད༔ རང་རིག་ཡེ་ཤེས་སྒྲོན་འོད་འབར༔ ཆོས་ཉིད་དག་པས་བཀྲ་ཤིས་མཛེས༔ ལྟ་བ་འཇིགས་བྲལ་སེང་རྩལ་རྫོགས༔ རང་རིག་སྨིན་པས་རྫོགས་རང་བྱུང༔ ལུ་གུ་རྒྱུད་འབྲེལ་མུ་ཏིག་ཕྲེང༔ ཉམས་ཀྱི་སྣང་བ་ནོར་ཕྲ་བཀོད༔ རང་གནས་སྟོང་པའི་སྙིང་མེ་ལོང༔ གོལ་ས་རང་གཅོད་ཐུགས་མེ་ལོང༔ གཞན་ལས་མ་བྱུང་རང་ཤར་ཉིད༔ རང་བྱུང་ཡིན་པས་རང་གྲོལ་ལོ༔ དབྱིངས་སུ་གཅིག་པས་ཀློང་ཡངས་དྲུག༔ ཡོན་ཏན་རྫོགས་པས་རིན་ཆེན་སྤུངས༔ རང་རིག་བསྟན་པས་ངོ་སྤྲོད་སྤྲས༔ སྣང་བ་དག་པས་ཉི་ཟླ་སྦྱོར༔ རིག་པ་སྨིན་ཕྱིར་སྐུ་གདུང་འབར༔ འདི་དག་རྣམས་ཀྱང་གཞི་ལས་ཤར༔” ཞེས་གསུངས་པ་ལྟར། ༼༡༽ ལྡེ་མིག་ལྟར་སྡེ་སྣོད་ཆོས་རྣམས་ཀུན་གྱི་སྒོ་འབྱེད་པར་སྟོན་པ་«སྒྲ་ཐལ་འགྱུར་ཆེན་པོ་རྩ་བའི་རྒྱུད་»དང་། ༼༢༽ རི་རྒྱལ་ལྟར་མི་འགྱུར་བའི་ཆོས་ཉིད་སྟོན་པ་«དཔལ་ཡི་གེ་མེད་པའི་རྒྱུད་»དང་། ༼༣༽ གསལ་ཤིང་ལྟར་སྒྲོན་མའི་སྣང་བ་སྟོན་པ་«སྒྲོན་མ་འབར་བའི་རྒྱུད་»དང་། ༼༤༽ འཁོར་ལོ་ལྟར་འཁྲུལ་པ་ཡོངས་སུ་གཅོད་པར་སྟོན་པ་«བཀྲ་ཤིས་མཛེས་ལྡན་གྱི་རྒྱུད་»དང་། ༼༥༽ སེང་གེ་ལྟར་ཐེག་པ་འོག་མ་རྣམས་ཟིལ་གྱིས་གནོན་པར་སྟོན་པ་«སེང་གེ་རྩལ་རྫོགས་ཀྱི་རྒྱུད་»དང་། ༼༦༽ ཆུ་བོའི་རྒྱུན་ལྟར་དབང་དང་བྱིན་རླབས་སྟོན་པ་«རྫོགས་པ་རང་བྱུང༌གི་རྒྱུད་»དང་། ༼༧༽ མུ་ཏིག་ཕྲེང་བརྒྱུས་ལྟར་མན་ངག་ཁྲིགས་ཆགས་སུ་སྟོན་པ་«མུ་ཏིག་ཕྲེང་བའི་རྒྱུད་»དང་། ༼༨༽ ཚིག་དོན་གྱི་གསེར་ལ་གཡུས་སྤྲས་པ་ལྟར་སྟོན་པ་«ནོར་བུ་ཕྲ་བཀོད་ཀྱི་རྒྱུད་»དང་། ༼༩༽ ཉི་མ་ལྟར་གསལ་བར་སྟོན་པ་«རྡོ་རྗེ་སེམས་དཔའ་སྙིང་གི་མེ་ལོང་གི་རྒྱུད་»དང་། ༼༡༠༽ རལ་གྲི་ལྟར་གོལ་ས་གཅོད་པར་སྟོན་པ་«ཀུན་ཏུ་བཟང་པོ་ཐུགས་ཀྱི་མེ་ལོང༌གི་རྒྱུད་»དང་། ༼༡༡༽ བརྗོད་བྱ་རྒྱ་མཚོ་ལྟར་ཟབ་ཅིང་རྒྱ་ཆེ་བར་སྟོན་པ་«རིག་པ་རང་ཤར་གྱི་རྒྱུད་»དང་། ༼༡༢༽ སྦྲུལ་གྱི་མདུད་པ་ལྟར་གཞུང་ཚིག་རང་གྲོལ་དུ་སྟོན་པ་«རིག་པ་རང་གྲོལ་གྱི་རྒྱུད་»དང་། ༼༡༣༽ ཁྱུང་ཆེན་པོ་ནམ་མཁའ་ལ་རྩོལ་སྒྲུབ་མེད་པར་འགྲོ་བ་ལྟར་སྟོན་པ་«ཀློང་ཡངས་དྲུག་པའི་རྒྱུད་»དང་། ༼༡༤༽ ཕྱུག་པོའི་བང་མཛོད་དུ་གང་འདོད་འབྱུང་བ་ལྟར་སྟོན་པ་«རིན་པོ་ཆེ་སྤུངས་པའི་རྒྱུད་»དང་། ༼༡༥༽ མེ་ལོང་གི་ནང་དུ་གཟུགས་བརྙན་བསྟན་པ་ལྟར་དཔེ་དོན་སྦྱར་ཏེ་སྟོན་པ་«ངོ་སྤྲོད་སྤྲས་པའི་རྒྱུད་»དང་། ༼༡༦༽ མ་བུ་ལྟར་ཡིད་ཆེས་ངེས་པའི་ཚིག་གིས་བར་དོ་ལ་གསལ་འདེབས་པར་སྟོན་པ་«ཉི་ཟླ་ཁ་སྦྱོར་གྱི་རྒྱུད་»དང་། ༼༡༧༽ རྒྱལ་པོའི་གདུང་མི་འགྱུར་བས་རྒྱལ་ས་ཟིན་པ་ལྟར་སྟོན་པ་«སྐུ་གདུང་འབར་བའི་རྒྱུད་»དང་། ༼༡༨༽ སྤུ་གྲི་ངར་མས་གང་ལ་རེག་པ་གཅོད་པ་ལྟར་འགལ་བྱེད་ཆམ་ལ་འབེབས་པ་«སྔགས་སྲུང་ཁྲོས་མ་ནག་མོའི་རྒྱུད་»དང་བཅོ་བརྒྱད།\n\nགསང་ཆེན་ངེས་པའི་རྒྱུད་དེ་རྣམས་«སྒང་སྟེང་དགོན་གྱི་རྙིང་རྒྱུད་སྔ་མ་དང་ཕྱི་མ་»དེ་བཞིན་«སྤ་སྒར་དགོན་གྱི་རྙིང་རྒྱུད་»དང་«དགྲ་མེད་རྩེ་དགོན་གྱི་རྙིང་རྒྱུད་» (WEAP105-1-1) «མཚམས་བྲག་དགོན་གྱི་རྙིང་རྒྱུད་» (WEAP310-4-1/W21521) «མོན་སངས་རྒྱས་གླིང་གི་རྙིང་རྒྱུད་» (W1KG16449) བཅས་ལྷོ་མོན་འབྲུག་ཡུལ་སོགས་སུ་ཁྱབ་སྤེལ་བྱུང་བའི་«རྙིང་མའི་རྒྱུད་འབུམ་»ཁག་དང་། དེ་བཞིན་«ཁམས་གཞི་ཆེན་དགོན་གྱི་རྙིང་རྒྱུད་» (W2PD17382) དང་«གཏིང་སྐྱེས་དགོན་པ་བྱང་གི་རྙིང་རྒྱུད་» (W21518) «སྡེ་དགེ་ལྷུན་གྲུབ་སྟེང་གི་རྙིང་རྒྱུད་» (W21939) བཅས་གངས་ཅན་བོད་ཀྱི་ཡུལ་དུ་དར་སྤེལ་བྱུང་བ་རྣམས་དང་། ཡང་«ནུབ་རིའི་རྙིང་རྒྱུད་»དང་«ཀཿཐོག་ཚེ་ནོར་གྱི་རྙིང་རྒྱུད་» (W2PD19896) «དོལ་པོ་རྟ་རབ་གད་དཀར་ཀྱི་རྙིང་རྒྱུད་» (W1BL6) སོགས་བལ་བོད་མཚམས་ནས་རྙེད་སོན་བྱུང་བ་རྣམས་དང་། ཡང་དེང་སང་བོད་ནས་དེང་རབས་འཕྲུལ་པར་གྱི་རྣམ་པ་ཅན་གསར་དུ་བསྐྲུན་པའི་«དཔལ་བརྩེགས་རྙིང་རྒྱུད་» (W1KG14783) དང་«ཀྲུང་གོ་བོད་རིག་པའི་རྙིང་རྒྱུད་» (W3CN3207) སོགས་«རྙིང་མའི་རྒྱུད་འབུམ་»ཆེ་ཁག་ཕལ་ཆེ་བར་«རྫོགས་ཆེན་རྒྱུད་བཅུ་བདུན་»འདི་ནི་བཞུགས་ཡོད། འོན་ཀྱང་འབྲུག་སྤ་གྲོ་«གདོང་དཀར་ལའི་རྙིང་རྒྱུད་»དང་ལ་དྭགས་རྟོགས་ལྡན་རིན་པོ་ཆེ་ (P7635) བརྒྱུད་ནས་རྙེད་པའི་«བཻ་རོ་རྙིང་རྒྱུད་» (W21519) གཉིས་སུ་བཞུགས་མེད།\nསྔ་འགྱུར་རྙིང་མའི་ཞིབ་འཇུག་ལྟེ་གནས་ཁང་ (NNRC) གི་ཞིབ་འཇུག་པ་མཁན་པོ་དཀོན་མཆོག་བསྟན་འཛིན་ནས།"},{"type":"http://purl.bdrc.io/ontology/core/workGenre","value":"http://purl.bdrc.io/resource/T448"},{"type":"http://purl.bdrc.io/ontology/core/printMethod","value":"http://purl.bdrc.io/resource/PrintMethod_Modern"}],"http://purl.bdrc.io/resource/MW1KG11703_0003_004":[{"type":"http://purl.bdrc.io/ontology/core/instanceOf","value":"http://purl.bdrc.io/resource/WA0RG0060"},{"xml:lang":"","type":"http://purl.bdrc.io/ontology/tmp/possibleAccess","value":"true"},{"type":"http://purl.bdrc.io/ontology/core/inRootInstance","value":"http://purl.bdrc.io/resource/MW1KG11703"},{"type":"http://purl.bdrc.io/ontology/core/partType","value":"http://purl.bdrc.io/resource/PartTypeText"},{"type":"http://purl.bdrc.io/ontology/core/printMethod","value":"http://purl.bdrc.io/resource/PrintMethod_Manuscript"},{"xml:lang":"","type":"http://purl.bdrc.io/ontology/tmp/hasEtext","value":"true"},{"xml:lang":"","type":"http://purl.bdrc.io/ontology/tmp/hasOpen","value":"true"},{"xml:lang":"","type":"http://purl.bdrc.io/ontology/tmp/hasImage","value":"true"},{"xml:lang":"","type":"http: